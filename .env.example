NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
PREVIEWFORGE_API_ORIGIN=http://localhost:4000
PREVIEWFORGE_POSTGRES_LOCAL_PORT=55432
PREVIEWFORGE_KAFKA_LOCAL_PORT=59092
DATABASE_URL=postgresql://previewforge:previewforge@localhost:55432/previewforge
KAFKA_BROKERS=localhost:59092
KAFKA_CLIENT_ID=previewforge-local
KAFKA_GROUP_ID=previewforge-worker-local
PREVIEWFORGE_TTL_SWEEP_INTERVAL_MS=60000
PREVIEWFORGE_ORPHAN_SWEEP_INTERVAL_MS=60000
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# OAuth/session cookies belong to the browser origin; the Next.js rewrite proxies
# this origin to API_PORT during local development.
PUBLIC_BASE_URL=http://localhost:3000
# 32-byte key encoded as 64 hexadecimal characters or base64/base64url.
ENCRYPTION_KEY=
SESSION_TTL_SECONDS=2592000
OAUTH_STATE_TTL_SECONDS=600
PREVIEW_TTL_SECONDS=86400
PREVIEW_BASE_DOMAIN=preview.localhost
CONTAINER_REGISTRY=localhost:55000
PREVIEWFORGE_REGISTRY_LOCAL_PORT=55000
BUILDKIT_ADDR=unix:///var/tmp/previewforge-buildkit/buildkitd.sock
# Optional JSON command for a pre-provisioned rootless BuildKit supervisor.
PREVIEWFORGE_LOCAL_BUILDKIT_COMMAND=
# Leave empty to derive the kind Docker-network gateway. If set, use the same
# host:port when staging PREVIEWFORGE_BUILDKIT_REGISTRY_HOST for BuildKit.
PREVIEWFORGE_REGISTRY_HOST=
REGISTRY_HOST=localhost:55000
PREVIEWFORGE_KUBERNETES_ENABLED=true
PREVIEWFORGE_KIND_CLUSTER=previewforge
PREVIEWFORGE_GATEWAY_LOCAL_PORT=18080
PREVIEWFORGE_KIND_HTTP_HOST_PORT=30080
PREVIEWFORGE_KIND_HTTPS_HOST_PORT=30443
PREVIEWFORGE_ENVOY_GATEWAY_WAIT_SECONDS=300
PREVIEWFORGE_LOCAL_STATE_DIR=/var/tmp/previewforge-local
