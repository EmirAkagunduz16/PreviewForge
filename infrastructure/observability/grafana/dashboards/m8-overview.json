      "targets": [{ "expr": "sum(rate(previewforge_http_requests_total[1m]))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "m8-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API failures",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(previewforge_api_errors_total[1m]))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "m8-prometheus" },
