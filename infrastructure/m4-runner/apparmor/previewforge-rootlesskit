#include <tunables/global>

# This profile is loaded only on the disposable M4 runner. It deliberately does
# not alter kernel.apparmor_restrict_unprivileged_userns globally.
# Deliberately omit an exec attachment. Ubuntu ships its own attachment for
# /usr/bin/rootlesskit; a second attachment conflicts and causes userns_create
# to fall through to the restrictive unprivileged_userns profile. The start
# script enters this named profile explicitly with aa-exec.
profile previewforge-rootlesskit flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  userns,
  network inet stream,
  network inet6 stream,
  capability setuid,
  capability setgid,
  capability sys_chroot,
  capability sys_admin,
  capability net_admin,
  capability net_raw,

  /usr/bin/rootlesskit rix,
  /usr/bin/buildkitd rix,
  /usr/local/bin/buildkitd rix,
  /usr/local/bin/registry rix,
  /usr/bin/slirp4netns rix,
  /usr/bin/fuse-overlayfs rix,
  /usr/bin/newuidmap px,
  /usr/bin/newgidmap px,
  /usr/lib/** rix,
  /lib/** rix,

  /etc/subuid r,
  /etc/subgid r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/ssl/** r,
  /run/user/** rwk,
  /var/tmp/previewforge-buildkit/** rwk,
  /var/tmp/previewforge-registry/** rwk,
  /tmp/previewforge-buildkit/** rwk,
  /proc/** r,
  /sys/** r,

  # Keep platform and host credentials outside the BuildKit trust zone.
  deny /var/run/docker.sock rwx,
  deny /run/docker.sock rwx,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /home/**/.ssh/** r,
  deny /home/**/.aws/** r,
  deny /home/**/.config/** r,
  deny /var/lib/** rwx,
  deny /etc/previewforge/** rwx,
}
