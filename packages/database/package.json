{
  "name": "@previewforge/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "pnpm test:unit",
    "test:integration": "node -e \"if (!process.env.DATABASE_URL) { console.error('DATABASE_URL is required for integration tests'); process.exit(1); }\" && vitest run test/*.integration.test.ts",
    "test:unit": "vitest run --passWithNoTests --exclude 'test/**/*.integration.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@previewforge/contracts": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
