generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  githubUserId       String         @unique @map("github_user_id")
  githubLogin        String         @map("github_login")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  installations      Installation[]
  projects           Project[]

  @@map("users")
}

model Installation {
  id                    String            @id @default(uuid()) @db.Uuid
  githubInstallationId  Int               @unique @map("github_installation_id")
  accountLogin          String            @map("account_login")
  accountType           String            @map("account_type")
  encryptedPrivateKey   String?           @map("encrypted_private_key")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  ownerId               String            @map("owner_id") @db.Uuid
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects              Project[]
  webhookDeliveries     WebhookDelivery[]

  @@index([ownerId])
  @@map("installations")
}

model Project {
  id                    String            @id @default(uuid()) @db.Uuid
  installationId        String            @map("installation_id") @db.Uuid
  ownerId               String            @map("owner_id") @db.Uuid
  repositoryFullName    String            @map("repository_full_name")
  defaultBranch         String            @default("main") @map("default_branch")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  installation           Installation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pullRequests           PullRequest[]
  environments           PreviewEnvironment[]

  @@unique([installationId, repositoryFullName])
  @@index([ownerId])
  @@map("projects")
}

model PullRequest {
  id                    String            @id @default(uuid()) @db.Uuid
  projectId             String            @map("project_id") @db.Uuid
  number                Int
  title                 String?
  headSha               String            @map("head_sha")
  state                 String            @default("OPEN")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment           PreviewEnvironment?

  @@unique([projectId, number])
  @@index([projectId, state])
  @@map("pull_requests")
}

model PreviewEnvironment {
  id                    String            @id @default(uuid()) @db.Uuid
  projectId             String            @map("project_id") @db.Uuid
  pullRequestId         String?           @unique @map("pull_request_id") @db.Uuid
  previewKey             String            @unique @map("preview_key")
  desiredCommitSha      String            @map("desired_commit_sha")
  status                String            @default("ACTIVE")
  expiresAt             DateTime?         @map("expires_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest           PullRequest?      @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  deployments           Deployment[]

  @@unique([projectId, previewKey])
  @@index([status, expiresAt])
  @@map("preview_environments")
}

model Deployment {
  id                    String            @id @default(uuid()) @db.Uuid
  environmentId         String            @map("environment_id") @db.Uuid
  attempt               Int               @default(1)
  commitSha             String            @map("commit_sha")
  status                String            @default("QUEUED")
  failureStage          String?           @map("failure_stage")
  failureCode           String?           @map("failure_code")
  failureMessage        String?           @map("failure_message")
  failureRetryable      Boolean?          @map("failure_retryable")
  checkRunId             String?           @map("check_run_id")
  imageDigest            String?          @map("image_digest")
  startedAt              DateTime?        @map("started_at")
  finishedAt             DateTime?        @map("finished_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  environment            PreviewEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  logChunks              LogChunk[]

  @@unique([environmentId, attempt])
  @@index([environmentId, status])
  @@index([commitSha])
  @@map("deployments")
}

model WebhookDelivery {
  id                    String            @id @default(uuid()) @db.Uuid
  deliveryId            String            @unique @map("delivery_id")
  eventName             String            @map("event_name")
  payloadSha256         String            @map("payload_sha256")
  installationId        String?           @map("installation_id") @db.Uuid
  receivedAt             DateTime          @default(now()) @map("received_at")
  processedAt            DateTime?         @map("processed_at")
  status                String            @default("RECEIVED")
  failureReason         String?           @map("failure_reason")
  installation           Installation?    @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([installationId, receivedAt])
  @@index([status, receivedAt])
  @@map("webhook_deliveries")
}

model OutboxEvent {
  id                    String            @id @default(uuid()) @db.Uuid
  eventType             String            @map("event_type")
  aggregateType         String            @map("aggregate_type")
  aggregateId           String            @map("aggregate_id") @db.Uuid
  payload               Json
  attempts              Int               @default(0)
  availableAt            DateTime          @default(now()) @map("available_at")
  publishedAt            DateTime?         @map("published_at")
  lastError              String?           @map("last_error")
  createdAt              DateTime          @default(now()) @map("created_at")

  @@index([publishedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model ConsumerReceipt {
  id                    String            @id @default(uuid()) @db.Uuid
  consumerName          String            @map("consumer_name")
  eventId               String            @map("event_id") @db.Uuid
  processedAt           DateTime          @default(now()) @map("processed_at")

  @@unique([consumerName, eventId])
  @@index([eventId])
  @@map("consumer_receipts")
}

model LogChunk {
  id                    String            @id @default(uuid()) @db.Uuid
  deploymentId          String            @map("deployment_id") @db.Uuid
  sequence              Int
  stage                 String
  stream                String
  text                  String
  emittedAt             DateTime          @default(now()) @map("emitted_at")
  deployment            Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, sequence])
  @@index([deploymentId, emittedAt])
  @@map("log_chunks")
}
