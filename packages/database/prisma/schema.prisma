generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  githubUserId     String            @unique @map("github_user_id")
  /// Canonical immutable GitHub numeric identity. The legacy text identity is
  /// retained for M1 rows and fixtures.
  githubNumericId  BigInt?           @unique @map("github_numeric_id")
  githubLogin      String            @map("github_login")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  installations    Installation[]
  projects         Project[]
  sessions         Session[]
  oauthStates      OAuthState[]
  githubCredential GitHubCredential?

  @@map("users")
}

model Installation {
  id                   String            @id @default(uuid()) @db.Uuid
  githubInstallationId BigInt            @unique @map("github_installation_id")
  /// GitHub account identity is immutable and can exceed a signed 32-bit int.
  githubAccountId      BigInt?           @unique @map("github_account_id")
  accountLogin         String            @map("account_login")
  accountType          String            @map("account_type")
  encryptedPrivateKey  String?           @map("encrypted_private_key")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  ownerId              String            @map("owner_id") @db.Uuid
  owner                User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects             Project[]
  webhookDeliveries    WebhookDelivery[]
  oauthStates          OAuthState[]

  @@index([ownerId])
  @@map("installations")
}

model Project {
  id                 String               @id @default(uuid()) @db.Uuid
  installationId     String               @map("installation_id") @db.Uuid
  ownerId            String               @map("owner_id") @db.Uuid
  /// Repository numeric identity survives renames; full name remains display
  /// metadata and is still scoped to the installation for M1 compatibility.
  githubRepositoryId BigInt?              @unique @map("github_repository_id")
  repositoryFullName String               @map("repository_full_name")
  defaultBranch      String               @default("main") @map("default_branch")
  dockerfilePath     String               @default("Dockerfile") @map("dockerfile_path")
  containerPort      Int                  @default(3000) @map("container_port")
  healthPath         String               @default("/") @map("health_path")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  installation       Installation         @relation(fields: [installationId], references: [id], onDelete: Cascade)
  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pullRequests       PullRequest[]
  environments       PreviewEnvironment[]
  environmentVariables ProjectEnvironmentVariable[]

  @@unique([installationId, repositoryFullName])
  @@index([ownerId])
  @@map("projects")
}

model ProjectEnvironmentVariable {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  key               String
  encryptedValue    String   @map("encrypted_value")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId, updatedAt])
  @@map("project_environment_variables")
}

model PullRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  projectId             String              @map("project_id") @db.Uuid
  number                Int
  title                 String?
  headSha               String              @map("head_sha")
  state                 String              @default("OPEN")
  /// GitHub's source timestamp is the ordering token for webhook updates.
  sourceUpdatedAt       DateTime?           @map("source_updated_at")
  lastWebhookDeliveryId String?             @map("last_webhook_delivery_id")
  lastWebhookEvent      String?             @map("last_webhook_event")
  lastWebhookAt         DateTime?           @map("last_webhook_at")
  closedAt              DateTime?           @map("closed_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment           PreviewEnvironment?

  @@unique([projectId, number])
  @@index([projectId, state])
  @@map("pull_requests")
}

model PreviewEnvironment {
  id               String                      @id @default(uuid()) @db.Uuid
  projectId        String                      @map("project_id") @db.Uuid
  pullRequestId    String?                     @unique @map("pull_request_id") @db.Uuid
  previewKey       String                      @unique @map("preview_key")
  desiredCommitSha String                      @map("desired_commit_sha")
  status           String                      @default("ACTIVE")
  expiresAt        DateTime?                   @map("expires_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  project          Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest      PullRequest?                @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  deployments      Deployment[]
  deletionRequest  EnvironmentDeletionRequest?

  @@unique([projectId, previewKey])
  @@index([status, expiresAt])
  @@map("preview_environments")
}

model Deployment {
  id               String             @id @default(uuid()) @db.Uuid
  environmentId    String             @map("environment_id") @db.Uuid
  attempt          Int                @default(1)
  commitSha        String             @map("commit_sha")
  status           String             @default("QUEUED")
  failureStage     String?            @map("failure_stage")
  failureCode      String?            @map("failure_code")
  failureMessage   String?            @map("failure_message")
  failureRetryable Boolean?           @map("failure_retryable")
  checkRunId       String?            @map("check_run_id")
  imageDigest      String?            @map("image_digest")
  startedAt        DateTime?          @map("started_at")
  finishedAt       DateTime?          @map("finished_at")
  leaseToken       String?            @map("lease_token") @db.Uuid
  leaseOwner       String?            @map("lease_owner")
  leaseGeneration  Int                @default(0) @map("lease_generation")
  leaseAcquiredAt  DateTime?          @map("lease_acquired_at")
  leaseRenewedAt   DateTime?          @map("lease_renewed_at")
  leaseExpiresAt   DateTime?          @map("lease_expires_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  environment      PreviewEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  logChunks        LogChunk[]

  @@unique([environmentId, attempt])
  @@index([environmentId, status])
  @@index([environmentId, leaseExpiresAt])
  @@index([status, leaseExpiresAt])
  @@index([commitSha])
  @@map("deployments")
}

model WebhookDelivery {
  id                    String        @id @default(uuid()) @db.Uuid
  deliveryId            String        @unique @map("delivery_id")
  eventName             String        @map("event_name")
  payloadSha256         String        @map("payload_sha256")
  installationId        String?       @map("installation_id") @db.Uuid
  receivedAt            DateTime      @default(now()) @map("received_at")
  processedAt           DateTime?     @map("processed_at")
  status                String        @default("RECEIVED")
  failureReason         String?       @map("failure_reason")
  sourceUpdatedAt       DateTime?     @map("source_updated_at")
  sourceSequence        BigInt?       @map("source_sequence")
  duplicateOfDeliveryId String?       @map("duplicate_of_delivery_id")
  installation          Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([installationId, receivedAt])
  @@index([status, receivedAt])
  @@map("webhook_deliveries")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  /// Only a one-way digest of the opaque browser token is persisted.
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthState {
  id                    String        @id @default(uuid()) @db.Uuid
  /// State and binding values are hashes of opaque values from the browser.
  stateHash             String        @unique @map("state_hash")
  bindingHash           String        @map("binding_hash")
  encryptedPkceVerifier String        @map("encrypted_pkce_verifier")
  flow                  String
  userId                String?       @map("user_id") @db.Uuid
  installationId        String?       @map("installation_id") @db.Uuid
  expiresAt             DateTime      @map("expires_at")
  consumedAt            DateTime?     @map("consumed_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  user                  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation          Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([expiresAt, consumedAt])
  @@index([userId, flow])
  @@map("oauth_states")
}

model GitHubCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  tokenType             String?   @map("token_type")
  scopes                String[]  @default([])
  ciphertextVersion     Int       @default(1) @map("ciphertext_version")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
  @@map("github_credentials")
}

model EnvironmentDeletionRequest {
  id               String             @id @default(uuid()) @db.Uuid
  environmentId    String             @unique @map("environment_id") @db.Uuid
  requestKey       String             @unique @map("request_key")
  status           String             @default("REQUESTED")
  sourceUpdatedAt  DateTime?          @map("source_updated_at")
  sourceDeliveryId String?            @map("source_delivery_id")
  requestedAt      DateTime           @default(now()) @map("requested_at")
  completedAt      DateTime?          @map("completed_at")
  failureReason    String?            @map("failure_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  environment      PreviewEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([sourceDeliveryId])
  @@map("environment_deletion_requests")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error")
  claimToken    String?   @map("claim_token") @db.Uuid
  claimOwner    String?   @map("claim_owner")
  claimExpiresAt DateTime? @map("claim_expires_at")
  lastAttemptAt DateTime? @map("last_attempt_at")
  deadLetteredAt DateTime? @map("dead_lettered_at")
  deadLetterReason String? @map("dead_letter_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, availableAt])
  @@index([publishedAt, availableAt, claimExpiresAt])
  @@index([deadLetteredAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model ConsumerReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  consumerName String   @map("consumer_name")
  eventId      String   @map("event_id") @db.Uuid
  processedAt  DateTime @default(now()) @map("processed_at")

  @@unique([consumerName, eventId])
  @@index([eventId])
  @@map("consumer_receipts")
}

/// Durable Kafka delivery metadata. The payload is intentionally absent; only
/// a digest and safe, parseable event identity are retained for retries and
/// dead-letter operations.
model KafkaDelivery {
  id              String    @id @default(uuid()) @db.Uuid
  consumerName    String    @map("consumer_name")
  topic           String
  partition       Int
  offset          BigInt
  eventId         String?   @map("event_id") @db.Uuid
  eventType       String?   @map("event_type")
  environmentId   String?   @map("environment_id") @db.Uuid
  aggregateId     String?   @map("aggregate_id") @db.Uuid
  payloadDigest   String    @map("payload_digest")
  status          String    @default("RECEIVED")
  attempts        Int       @default(1)
  availableAt     DateTime  @default(now()) @map("available_at")
  lastAttemptAt   DateTime? @map("last_attempt_at")
  processedAt     DateTime? @map("processed_at")
  deadLetteredAt  DateTime? @map("dead_lettered_at")
  errorCode       String?   @map("error_code")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([consumerName, topic, partition, offset])
  @@index([consumerName, eventId])
  @@index([status, availableAt])
  @@index([payloadDigest])
  @@map("kafka_deliveries")
}

model LogChunk {
  id           String     @id @default(uuid()) @db.Uuid
  deploymentId String     @map("deployment_id") @db.Uuid
  sequence     Int
  stage        String
  stream       String
  text         String
  emittedAt    DateTime   @default(now()) @map("emitted_at")
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, sequence])
  @@index([deploymentId, emittedAt])
  @@map("log_chunks")
}
