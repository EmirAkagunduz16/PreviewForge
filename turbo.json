{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "DOCKER_CONTEXT",
    "PREVIEWFORGE_DOCKER_CONTEXT",
    "PREVIEWFORGE_LOCAL_STATE_DIR",
    "M8_DATABASE_URL",
    "M8_KAFKA_BROKERS",
    "M8_API_PORT",
    "M8_WORKER_OBSERVABILITY_PORT",
    "M8_RUN_ID",
    "DOCKER_HOST",
    "M8_BUILDKIT_SOCKET",
    "M5_IMAGE_REFERENCE",
    "M5_IMAGE_DIGEST",
    "M5_GATEWAY_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "LOG_LEVEL",
        "API_HOST",
        "API_PORT",
        "WEB_PORT",
        "PREVIEWFORGE_API_ORIGIN",
        "DATABASE_URL",
        "KAFKA_BROKERS",
        "KAFKA_CLIENT_ID",
        "KAFKA_GROUP_ID",
        "GITHUB_APP_ID",
        "GITHUB_PRIVATE_KEY",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",
        "GITHUB_APP_SLUG",
        "GITHUB_API_BASE_URL",
        "GITHUB_OAUTH_BASE_URL",
        "PUBLIC_BASE_URL",
        "ENCRYPTION_KEY",
        "SESSION_TTL_SECONDS",
        "OAUTH_STATE_TTL_SECONDS",
        "PREVIEW_TTL_SECONDS",
        "PREVIEW_BASE_DOMAIN",
        "PREVIEW_URL_SCHEME",
        "CONTAINER_REGISTRY",
        "BUILDKIT_ADDR",
        "REGISTRY_HOST",
        "PREVIEWFORGE_KUBERNETES_ENABLED",
        "PREVIEWFORGE_KIND_CLUSTER",
        "PREVIEWFORGE_GATEWAY_LOCAL_PORT",
        "PREVIEWFORGE_KIND_HTTP_HOST_PORT",
        "PREVIEWFORGE_KIND_HTTPS_HOST_PORT",
        "PREVIEWFORGE_ENVOY_GATEWAY_WAIT_SECONDS",
        "PREVIEWFORGE_WORKER_OBSERVABILITY_HOST",
        "PREVIEWFORGE_WORKER_OBSERVABILITY_PORT",
        "PREVIEWFORGE_TTL_SWEEP_INTERVAL_MS",
        "PREVIEWFORGE_ORPHAN_SWEEP_INTERVAL_MS",
        "PREVIEWFORGE_HEALTHCHECK_TIMEOUT_MS",
        "PREVIEWFORGE_HEALTHCHECK_URL_TEMPLATE",
        "PREVIEWFORGE_ROLLOUT_POLL_INTERVAL_MS",
        "PREVIEWFORGE_ROLLOUT_TIMEOUT_MS",
        "PREVIEWFORGE_OTEL_EXPORTER_ENDPOINT",
        "KUBECONFIG",
        "KUBE_CONTEXT"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
