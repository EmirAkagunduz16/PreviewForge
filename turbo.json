{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["DOCKER_CONTEXT", "PREVIEWFORGE_DOCKER_CONTEXT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
